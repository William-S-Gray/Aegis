# Copy to .env and adjust. Never commit a real .env.

VISION_ENVIRONMENT=development

# --- API ---
VISION_API_URL=http://localhost:8000/api/v1
# Dedicated service account. Create it with --role service (NOT guard): a
# service account may only publish detections.
VISION_SERVICE_EMAIL=vision@aegis.example
VISION_SERVICE_PASSWORD=
VISION_SITE_ID=

# --- Detector ---
# "stub" produces synthetic output and is refused outside development.
VISION_DETECTOR=stub
VISION_READER=stub
# Required when VISION_DETECTOR=yolo. Must be plate-specific weights.
VISION_MODEL_PATH=
VISION_DEVICE=
VISION_DETECTOR_CONFIDENCE=0.25

# --- Observability ---
VISION_LOG_LEVEL=INFO
VISION_LOG_JSON=true
# Optional: run counters written here after each pass, for a metrics sidecar.
VISION_STATS_PATH=

# --- Capture ---
# Comma-separated: image directories, video files, RTSP or MJPEG URLs.
VISION_SOURCES=./samples
VISION_FRAME_INTERVAL_SECONDS=1.0
VISION_DEDUPE_WINDOW_SECONDS=30
VISION_MIN_PUBLISH_CONFIDENCE=0.50
