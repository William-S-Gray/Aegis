# Copy to .env and adjust. Never commit a real .env.

ENVIRONMENT=development

# SQLAlchemy URL. The docker-compose service listens on 5435 to avoid colliding
# with any PostgreSQL already running on the host.
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5435/aegis

# REQUIRED in staging and production; the app refuses to start without it there.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Shared state across API replicas (login throttling, WebSocket tickets).
# REQUIRED outside development: without it each replica rate-limits only
# itself, so N replicas allow N times the configured attempts.
REDIS_URL=redis://localhost:6383/0

# Plate-read confidence gating. Reads at or above the auto-accept threshold are
# acted on; between the two they go to the human review queue; below the floor
# they are refused outright.
PLATE_AUTO_ACCEPT_CONFIDENCE=0.85
PLATE_REVIEW_FLOOR_CONFIDENCE=0.50
TYPE_REVIEW_CONFIDENCE=0.60

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated. Never "*" — the API sends credentials.
CORS_ORIGINS=http://localhost:5173

# --- Data retention (days) ---
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_ACCESS_LOG_DAYS=365
RETENTION_ALERT_DAYS=365
RETENTION_REFRESH_TOKEN_DAYS=30

# --- Observability ---
LOG_LEVEL=INFO
# JSON for a log aggregator; set false for readable local output.
LOG_JSON=true
# Prometheus scrape endpoint. Bind it to an internal network, or set a token:
# request rates and error counts are useful reconnaissance.
METRICS_ENABLED=true
METRICS_TOKEN=

# Failed logins per email+IP before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
