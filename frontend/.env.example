# Copy to .env.local and adjust per environment. Do not commit real .env files.

# REST API base URL (include the version prefix)
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket base URL. Optional: derived from VITE_API_URL when omitted
# (https -> wss, http -> ws). Set explicitly if the socket lives elsewhere.
# VITE_WS_URL=ws://localhost:8000


# Dev-only mock authentication. MUST be unset or "false" in staging/production —
# when "true" the app authenticates against an in-memory user list instead of the API.
VITE_ENABLE_MOCK_AUTH=false
