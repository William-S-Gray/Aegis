# Full-stack compose configuration. Copy to .env and fill in.
# Never commit a real .env.

ENVIRONMENT=production

# --- Database ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=
POSTGRES_DB=aegis

# --- API ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Must list the browser origin the frontend is served from. Never "*".
CORS_ORIGINS=http://localhost:8080

# --- Published ports (offset to avoid host collisions) ---
FRONTEND_PORT=8080
API_PORT=8081

# --- Frontend runtime config ---
# The URL the BROWSER uses to reach the API, not the internal service name.
PUBLIC_API_URL=http://localhost:8081/api/v1

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
# REQUIRED outside development. Also write it to monitoring/metrics-token so
# Prometheus can scrape:  printf '%s' "$METRICS_TOKEN" > monitoring/metrics-token
METRICS_TOKEN=
# Reverse proxy addresses allowed to set X-Forwarded-For (comma-separated).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Monitoring (profile: monitoring) ---
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3030
# Where firing alerts go is set in monitoring/alertmanager.yml itself
# (Alertmanager does not read environment variables). Replace its placeholder
# receivers with a real integration before relying on alerting.
GRAFANA_PASSWORD=

# --- Backups ---
# Encrypt to this recipient (gpg key id/uid, or an age recipient). Asymmetric:
# the backup host holds only the public key and cannot read its own backups.
BACKUP_ENCRYPT_TO=
# Off-box copy. {} is replaced with the file path.
#   BACKUP_UPLOAD_CMD=aws s3 cp {} s3://your-bucket/aegis/
BACKUP_UPLOAD_CMD=

# --- Data retention (days) ---
# Plate data is personal data; set these from your DPIA, not from these
# defaults. Audit logs outlive operational data deliberately.
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_ACCESS_LOG_DAYS=365
RETENTION_ALERT_DAYS=365

# How long to keep backup files (scripts/backup.sh).
BACKUP_RETAIN_DAYS=30

# --- Vision service (profile: vision) ---
# Create with: app.cli create-user --role service  (never --role guard)
# The vision service follows ENVIRONMENT; "stub" is refused outside development.
VISION_SERVICE_EMAIL=vision@aegis.example
VISION_SERVICE_PASSWORD=
# "onnx" is real detection and reading; "stub" fabricates plates and is
# refused unless VISION_ENVIRONMENT=development.
VISION_DETECTOR=onnx
VISION_READER=onnx
VISION_SOURCES=/data/samples
# Live preview frames sent to the guard console, per camera; 0 disables.
VISION_PREVIEW_INTERVAL_SECONDS=1
VISION_DATA_DIR=./backend/vision_service/samples
